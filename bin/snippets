#!/usr/bin/env node

// Saves the book's tested examples, chapter by chapter, for the Run buttons on the site (docs/js/VerseRun.js): the
// displayed code of each, with the hidden setup before it and the hidden checks after it. A page finds its examples by
// their code and composes each one's test as bin/extract does (docs/js/VerseSnippets.mjs).
//
// Usage: snippets <out-dir>   (from the book's root: writes <out-dir>/<chapter>.json)
//
// Every example the book tests gets a Run button, whether it prints or not: one that prints nothing still shows that
// it compiles and runs, and the reader can edit it. A chapter with no tested example gets no file.
//
// The site's build runs this (hooks/run_buttons.py) and publishes the files as snippets/<chapter>.json.

const fs = require('fs');
const path = require('path');
const { pathToFileURL } = require('url');

function findMarkdownFiles(dir) {
  let results = [];
  for (const item of fs.readdirSync(dir).sort()) {
    // Skip hidden files
    if (item.startsWith('.')) {
      continue;
    }
    const fullPath = path.join(dir, item);
    const stat = fs.statSync(fullPath);
    if (stat.isDirectory()) {
      results = results.concat(findMarkdownFiles(fullPath));
    } else if (stat.isFile() && (item.endsWith('.md') || item.endsWith('.markdown'))) {
      results.push(fullPath);
    }
  }
  return results;
}

// Every chapter under docsDir that has tested examples: [{ chapter, source, snippets }], `chapter` being the source's
// path without its extension ("07_control") and `snippets` what extractVerseSnippets finds in it.
async function readChapters(docsDir) {
  const { extractVerseSnippets } = await import(
    pathToFileURL(path.join(__dirname, '..', 'docs', 'js', 'VerseSnippets.mjs')).href);

  // The chapters' warnings are bin/extract's to report: here they would only repeat.
  const warn = console.warn;
  console.warn = () => {};
  const chapters = [];
  try {
    for (const file of findMarkdownFiles(docsDir)) {
      const source = path.relative(docsDir, file).split(path.sep).join('/');
      const snippets = extractVerseSnippets(fs.readFileSync(file, 'utf-8'), path.basename(file));
      if (snippets.length > 0) {
        chapters.push({ chapter: source.replace(/\.(md|markdown)$/, ''), source, snippets });
      }
    }
  } finally {
    console.warn = warn;
  }
  return chapters;
}

async function main() {
  const dirs = process.argv.slice(2);
  if (dirs.length !== 1 || dirs[0].startsWith('--')) {
    console.error('Usage: snippets <out-dir>');
    process.exit(1);
  }
  const docsDir = path.join(process.cwd(), 'docs');
  if (!fs.existsSync(docsDir)) {
    console.error('Error: docs directory not found in current directory');
    process.exit(1);
  }
  const outDir = path.resolve(dirs[0]);
  fs.mkdirSync(outDir, { recursive: true });

  let pages = 0;
  let total = 0;
  for (const { chapter, source, snippets } of await readChapters(docsDir)) {
    const outFile = path.join(outDir, chapter + '.json');
    fs.mkdirSync(path.dirname(outFile), { recursive: true });
    fs.writeFileSync(outFile, JSON.stringify({
      source,
      snippets: snippets.map(({ number, code, prepend, append }) => ({ number, code, prepend, append }))
    }) + '\n');
    pages++;
    total += snippets.length;
  }
  console.log(`Saved ${total} example(s) of ${pages} chapter(s) in ${outDir}`);
}

main().catch(error => {
  console.error(error);
  process.exit(1);
});
