#!/usr/bin/env node

// Saves the examples that get a Run button on the site (docs/js/VerseRun.js), chapter by chapter: the displayed code
// of each, with the hidden setup before it and the hidden checks after it. A page finds its examples by their code
// and composes each one's test as bin/extract does (docs/js/VerseSnippets.mjs).
//
// Usage: snippets <out-dir> [--all]   (from the book's root: writes <out-dir>/<chapter>.json)
//
// An example gets a Run button when running it shows something: the ones examples_with_output.json lists, which
// bin/outputs records by running every example. --all saves every tested example instead (for tools that look at
// them all). A chapter with no example to save gets no file.
//
// The site's build runs this (hooks/run_buttons.py) and publishes the files as snippets/<chapter>.json.

const fs = require('fs');
const path = require('path');
const { pathToFileURL } = require('url');

const OUTPUTS_FILE = path.join(__dirname, '..', 'examples_with_output.json');

function findMarkdownFiles(dir) {
  let results = [];
  for (const item of fs.readdirSync(dir).sort()) {
    // Skip hidden files
    if (item.startsWith('.')) {
      continue;
    }
    const fullPath = path.join(dir, item);
    const stat = fs.statSync(fullPath);
    if (stat.isDirectory()) {
      results = results.concat(findMarkdownFiles(fullPath));
    } else if (stat.isFile() && (item.endsWith('.md') || item.endsWith('.markdown'))) {
      results.push(fullPath);
    }
  }
  return results;
}

// Every chapter under docsDir that has tested examples: [{ chapter, source, snippets }], `chapter` being the source's
// path without its extension ("07_control") and `snippets` what extractVerseSnippets finds in it.
async function readChapters(docsDir) {
  const { extractVerseSnippets } = await import(
    pathToFileURL(path.join(__dirname, '..', 'docs', 'js', 'VerseSnippets.mjs')).href);

  // The chapters' warnings are bin/extract's to report: here they would only repeat.
  const warn = console.warn;
  console.warn = () => {};
  const chapters = [];
  try {
    for (const file of findMarkdownFiles(docsDir)) {
      const source = path.relative(docsDir, file).split(path.sep).join('/');
      const snippets = extractVerseSnippets(fs.readFileSync(file, 'utf-8'), path.basename(file));
      if (snippets.length > 0) {
        chapters.push({ chapter: source.replace(/\.(md|markdown)$/, ''), source, snippets });
      }
    }
  } finally {
    console.warn = warn;
  }
  return chapters;
}

// The examples that print when they run, as bin/outputs recorded them: { <chapter>: [<number>, ...] }, or null when
// the record isn't there.
function readOutputs() {
  try {
    return JSON.parse(fs.readFileSync(OUTPUTS_FILE, 'utf-8')).examples;
  } catch {
    return null;
  }
}

async function main() {
  const args = process.argv.slice(2);
  const all = args.includes('--all');
  const dirs = args.filter(arg => !arg.startsWith('--'));
  if (dirs.length !== 1) {
    console.error('Usage: snippets <out-dir> [--all]');
    process.exit(1);
  }
  const docsDir = path.join(process.cwd(), 'docs');
  if (!fs.existsSync(docsDir)) {
    console.error('Error: docs directory not found in current directory');
    process.exit(1);
  }
  const outputs = all ? null : readOutputs();
  if (!all && !outputs) {
    console.error(`Error: ${path.basename(OUTPUTS_FILE)} not found: bin/outputs makes it`);
    process.exit(1);
  }

  const outDir = path.resolve(dirs[0]);
  fs.mkdirSync(outDir, { recursive: true });

  let pages = 0;
  let total = 0;
  for (const { chapter, source, snippets } of await readChapters(docsDir)) {
    const listed = all ? snippets : snippets.filter(snippet => (outputs[chapter] || []).includes(snippet.number));
    if (listed.length === 0) {
      continue;
    }
    const outFile = path.join(outDir, chapter + '.json');
    fs.mkdirSync(path.dirname(outFile), { recursive: true });
    fs.writeFileSync(outFile, JSON.stringify({
      source,
      snippets: listed.map(({ number, code, prepend, append }) => ({ number, code, prepend, append }))
    }) + '\n');
    pages++;
    total += listed.length;
  }
  console.log(`Saved ${total} example(s) of ${pages} chapter(s) in ${outDir}`);
}

// Run as a command; bin/outputs loads this file for readChapters.
if (require.main === module) {
  main().catch(error => {
    console.error(error);
    process.exit(1);
  });
}

module.exports = { readChapters, readOutputs, OUTPUTS_FILE };
