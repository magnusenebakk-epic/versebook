#!/usr/bin/env node

// Records which of the book's tested examples print something when they run: examples_with_output.json. Those are the
// examples the site gives a Run button (bin/snippets): running any other shows nothing.
//
// Usage: outputs            (from the book's root) runs every tested example and writes the record
//        outputs --check    runs them and exits 1 if the record isn't what the runs give
//
// Each example runs as its test (docs/js/VerseSnippets.mjs composes it, as for bin/extract) with Print printing, in
// the TestScript VM, which is found and run as bin/vtest does (VERSE_TESTSCRIPT_VM, the PATH, VERSE_BIN). An example
// counts when its test passes and it printed at least one line. Run this again after changing what an example
// prints, or adding one that prints.

const fs = require('fs');
const os = require('os');
const path = require('path');
const { pathToFileURL } = require('url');
const { runTest } = require('./vtest');
const { readChapters, readOutputs, OUTPUTS_FILE } = require('./snippets');

const ABOUT = 'The tested examples that print something when they run: the ones with a Run button on the site. ' +
      'Made by bin/outputs; do not edit.';

async function main() {
  const check = process.argv.includes('--check');
  const docsDir = path.join(process.cwd(), 'docs');
  if (!fs.existsSync(docsDir)) {
    console.error('Error: docs directory not found in current directory');
    process.exit(1);
  }
  const { composeTest, readTestOutput } = await import(
    pathToFileURL(path.join(__dirname, '..', 'docs', 'js', 'VerseSnippets.mjs')).href);

  // The tests go next to bin/extract's, where the VM can read them from any of the shells bin/vtest supports (a
  // folder bin/vtest itself skips: its name starts with a dot).
  const workDir = path.join(process.cwd(), 'verse', '.outputs');
  fs.rmSync(workDir, { recursive: true, force: true });

  const tests = [];
  for (const { chapter, snippets } of await readChapters(docsDir)) {
    for (const snippet of snippets) {
      const { content, where } = composeTest(snippet, { printOutput: true });
      const file = path.join(workDir, chapter, snippet.number + '.versetest');
      fs.mkdirSync(path.dirname(file), { recursive: true });
      fs.writeFileSync(file, content + '\n\n');
      tests.push({ chapter, number: snippet.number, file, where });
    }
  }

  console.log(`Running ${tests.length} example(s)...`);
  const examples = {};
  let next = 0;
  let failed = 0;
  await Promise.all(Array.from({ length: Math.max(1, Math.min(8, os.cpus().length)) }, async () => {
    while (next < tests.length) {
      const test = tests[next++];
      const result = await runTest(test.file);
      if (!result.success) {
        failed++;
      } else if (readTestOutput(result.output.split('\n'), test.where).printed.length > 0) {
        (examples[test.chapter] ||= []).push(test.number);
      }
    }
  }));
  fs.rmSync(workDir, { recursive: true, force: true });

  const sorted = {};
  for (const chapter of Object.keys(examples).sort()) {
    sorted[chapter] = examples[chapter].sort();
  }
  const count = Object.values(sorted).reduce((sum, numbers) => sum + numbers.length, 0);
  console.log(`${count} of ${tests.length} example(s) print something` +
              (failed ? `; ${failed} didn't pass their test (bin/vtest shows why) and aren't counted` : ''));

  if (check) {
    const recorded = readOutputs();
    if (JSON.stringify(recorded) !== JSON.stringify(sorted)) {
      const flat = (record) => Object.entries(record || {}).flatMap(([chapter, numbers]) => numbers.map(number => `${chapter}/${number}`));
      const now = new Set(flat(sorted));
      const before = new Set(flat(recorded));
      for (const name of [...now].filter(name => !before.has(name))) console.log(`  prints now, not recorded: ${name}`);
      for (const name of [...before].filter(name => !now.has(name))) console.log(`  recorded, prints nothing now: ${name}`);
      console.error(`${path.basename(OUTPUTS_FILE)} is out of date: run bin/outputs`);
      process.exit(1);
    }
    console.log(`${path.basename(OUTPUTS_FILE)} is up to date`);
    return;
  }
  fs.writeFileSync(OUTPUTS_FILE, JSON.stringify({ about: ABOUT, examples: sorted }, null, 2) + '\n');
  console.log(`Wrote ${path.basename(OUTPUTS_FILE)}`);
}

main().catch(error => {
  console.error(error);
  process.exit(1);
});
